    sleep@10006000 {
        compatible = "mediatek,sleep";
        reg = <0x0 0x10006000 0x0 0x1000>;
        interrupts = <0x0 0x7d 0x8>;
        wakeup-source = <0x10 0x0 0x4 0x11 0x1 0x20 0x12 0x3 0x2000000>;
    };
    pinctrl@1000b000 {
        compatible = "mediatek,mt6761-pinctrl";
        reg = <0x0 0x1000b000 0x0 0x1000>;
        mediatek,pctl-regmap = <0x13 0x14 0x15 0x16 0x17 0x18 0x19 0x1a>;
        pins-are-numbered;
        gpio-controller;
        #gpio-cells = <0x2>;
        interrupt-controller;
        #interrupt-cells = <0x4>;
        interrupts = <0x0 0x73 0x4>;
        linux,phandle = <0xe>;
        phandle = <0xe>;
        eint60default {
            linux,phandle = <0xd>;
            phandle = <0xd>;
            pins_cmd_dat {
                pinmux = <0x5c00 0x900 0xa00>;
                slew-rate = <0x0>;
                bias-pull-up = <0x65>;
                input-enable;
            };
        };
        msdc0@default {
            linux,phandle = <0x2f>;
            phandle = <0x2f>;
            pins_cmd {
                drive-strength = [ 03 ];
            };
            pins_dat {
                drive-strength = [ 03 ];
            };
            pins_clk {
                drive-strength = [ 03 ];
            };
            pins_rst {
                drive-strength = [ 03 ];
            };
            pins_ds {
                drive-strength = [ 03 ];
            };
        };
        msdc0@hs400 {
            linux,phandle = <0x30>;
            phandle = <0x30>;
            pins_cmd {
                drive-strength = [ 03 ];
            };
            pins_dat {
                drive-strength = [ 04 ];
            };
            pins_clk {
                drive-strength = [ 04 ];
            };
            pins_rst {
                drive-strength = [ 03 ];
            };
            pins_ds {
                drive-strength = [ 04 ];
            };
        };
        msdc0@hs200 {
            linux,phandle = <0x31>;
            phandle = <0x31>;
            pins_cmd {
                drive-strength = [ 03 ];
            };
            pins_dat {
                drive-strength = [ 04 ];
            };
            pins_clk {
                drive-strength = [ 04 ];
            };
            pins_rst {
                drive-strength = [ 03 ];
            };
            pins_ds {
                drive-strength = [ 04 ];
            };
        };
        msdc0@register_default {
            cmd_edge = [ 00 ];
            rdata_edge = [ 00 ];
            wdata_edge = [ 00 ];
