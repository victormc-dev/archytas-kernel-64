    syscfg_pctl_0@10005000 {
        compatible = [ 6d 65 64 69 61 74 65 6b 2c 6d 74 36 37 36 31 2d 70 63 74 6c 2d 30 2d 73 79 73 63 66 67 00 73 79 73 63 6f 6e 00 ];
        reg = <0x0 0x10005000 0x0 0x1000>;
