    };
    topckgen@10000000 {
        compatible = [ 6d 65 64 69 61 74 65 6b 2c 74 6f 70 63 6b 67 65 6e 00 73 79 73 63 6f 6e 00 ];
        reg = <0x0 0x10000000 0x0 0x1000>;
