        compatible = <0x6d656469 0x6174656b 0x2c696e66 0x72616366 0x675f616f 0x737973 0x636f6e00>;
        reg = <0x0 0x10001000 0x0 0x1000>;
        interrupts = <0x0 0x5b 0x1>;
